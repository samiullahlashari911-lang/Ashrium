{% if template.name == 'product' and product %}
  <script>
    (function () {
      if (document.getElementById('ashrium-vfr-app-embed')) return;
      var appOrigin = {{ block.settings.platform_url | json }};
      if (!appOrigin) return;
      try {
        appOrigin = new URL(appOrigin).origin;
      } catch (error) {
        return;
      }

      var sku = {{ product.selected_or_first_available_variant.sku | json }};
      var handle = {{ product.handle | json }};
      var variants = {{ product.variants | json }};

      function normalizeSize(value) {
        return String(value || '').trim().toLowerCase();
      }

      function selectNativeVariant(size) {
        var normalizedSize = normalizeSize(size);
        var match = (variants || []).find(function (variant) {
          return Array.isArray(variant.options) && variant.options.some(function (option) {
            return normalizeSize(option) === normalizedSize;
          });
        });
        if (!match) return;
        document.querySelectorAll('form[action*="/cart/add"]').forEach(function (form) {
          var variantSelect = form.querySelector('select[name="id"]');
          var variantInput = form.querySelector('input[name="id"]');
          if (variantSelect) {
            variantSelect.value = String(match.id);
            variantSelect.dispatchEvent(new Event('change', { bubbles: true }));
          } else if (variantInput) {
            variantInput.value = String(match.id);
            variantInput.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      }

      window.addEventListener('message', function (event) {
        if (event.origin !== appOrigin || !event.data || event.data.source !== 'ashrium-vfr') return;
        if (event.data.type === 'VFR_SIZE_RECOMMENDED' && event.data.payload) {
          selectNativeVariant(event.data.payload.size);
        }
      });

      function inject() {
        if (document.getElementById('ashrium-vfr-app-embed')) return;
        var forms = document.querySelectorAll('form[action*="/cart/add"]');
        var form = forms[0];
        var mount = document.createElement('div');
        mount.id = 'ashrium-vfr-app-embed';
        if (form) {
          var submit = form.querySelector('[type="submit"], button[name="add"]');
          if (submit && submit.parentNode) {
            submit.parentNode.insertBefore(mount, submit);
          } else {
            form.insertBefore(mount, form.firstChild);
          }
        } else {
          document.body.appendChild(mount);
        }

        var script = document.createElement('script');
        script.src = appOrigin + '/vfr-widget.js?v=no-sandbox-launcher-1';
        script.async = true;
        script.dataset.launcher = 'true';
        script.dataset.sku = sku || '';
        script.dataset.handle = handle || '';
        mount.appendChild(script);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', inject);
      } else {
        inject();
      }
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Ashrium Try On",
  "target": "body",
  "settings": [
    {
      "type": "url",
      "id": "platform_url",
      "label": "Ashrium platform URL"
    }
  ]
}
{% endschema %}
