{
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:next": "node ./node_modules/next/dist/bin/next dev",
    "dev:launch": "cmd /c start \"\" http://localhost:3000/merchant && node ./scripts/dev.mjs",
    "check:merchant": "node ./scripts/check-merchant-route.mjs",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "node ./node_modules/eslint/bin/eslint.js app components lib types middleware.ts",
    "check": "npm run typecheck && npm run lint",
    "test": "npm run backend:smoke",
    "backend:dev": "python -m uvicorn backend.main:app --reload --host 127.0.0.1 --port 8000",
    "backend:smoke": "python -c \"from backend.main import app; assert app.openapi()['info']['title'] == 'VFR Local Server Engine'\"",
    "supabase:start": "npx --yes supabase@2.110.0 start",
    "supabase:verify": "npx --yes supabase@2.110.0 db reset --local",
    "supabase:stop": "npx --yes supabase@2.110.0 stop --no-backup"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.9",
    "next": "^15.5.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  }
}
