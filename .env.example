# Public Supabase connection values. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only credential. Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only widget access secret. Generate at least 32 random characters.
WIDGET_EMBED_SIGNING_SECRET=replace-with-a-long-random-secret

# Server-only AES-256-GCM key for tenant-managed provider credentials.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TENANT_KEY_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Server-only Modal A100 inference. Fail closed if unset — no mock fallback.
# MODAL_GPU_URL is the HTTPS web endpoint from `modal deploy gpu/modal_app.py`.
# ASHRIUM_GPU_HMAC must match the Modal secret (at least 16 characters).
MODAL_GPU_URL=
ASHRIUM_GPU_HMAC=
# Public HTTPS origin of this Next.js app.
APP_BASE_URL=https://your-deployment.example.com

# Server-only Shopify Partner app (Ashrium VFR) OAuth for merchant catalog ingest.
# Dev Dashboard → Ashrium VFR → Settings → Credentials.
# Whitelist APP_BASE_URL/api/v1/shopify/oauth/callback in the Partner app URLs.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional override when APP_BASE_URL is not the OAuth redirect host:
# SHOPIFY_OAUTH_REDIRECT_URI=https://your-deployment.example.com/api/v1/shopify/oauth/callback

# One-time hosted DB repair / migration push only. Supabase Dashboard → Database → password.
# Do not commit. Used by `npm run db:repair-auth` and `npm run supabase:push`.
# SUPABASE_DB_PASSWORD=

# HuggingFace token for gated facebook/sam-3d-body-dinov3. Required as a
# Modal secret (`HF_TOKEN`) so the Volume can prefetch SAM 3D Body.
# Never commit it.
# HF_TOKEN=

# Server-only. Authenticates the privacy TTL sweep. Also accepted on
# POST /api/v1/hmr/keepalive for operator GPU scale. Do not point a
# Vercel cron at keepalive just to keep the A100 warm.
# Vercel sends Authorization: Bearer $CRON_SECRET to:
#   GET /api/v1/cron/ttl-sweep
# CRON_SECRET=

# Server-only operator secret. At least 16 characters. Never prefix with NEXT_PUBLIC_.
# Used by POST /api/v1/operator/invite-merchant, `npm run merchant:invite`,
# and POST /api/v1/hmr/keepalive (manual Warm/Sleep). Merchants cannot scale.
ASHRIUM_OPERATOR_SECRET=replace-with-a-long-random-secret

# Allowed browser origins for Next.js API CORS. Comma-separate production storefront domains.
ASHRIUM_ALLOWED_ORIGINS=http://localhost:3000

# Public marketing page: Book a Call writes a row, then opens this Calendly event.
# Sheet tab must be named Sheet1 with columns:
# submitted_at, company_name, shopify_store_url, annual_recurring_revenue_usd
# Share the sheet with the service account email as Editor. Never commit the JSON.
# NEXT_PUBLIC_CALENDLY_EVENT_URL=https://calendly.com/your-team/intro
# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Product analytics (marketing page + merchant dashboard only; never the shopper widget).
# PostHog → Project settings → Project API key. Host: https://us.i.posthog.com or https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
